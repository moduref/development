PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=replace-this-with-a-long-random-value

# Driver Database: "sqlite", "mysql", atau "postgres" ("pgsql")
DB_DRIVER=sqlite

# Konfigurasi SQLite (Default: siap jalan langsung tanpa server database)
DB_SQLITE_PATH=database.sqlite

# Konfigurasi MySQL / MariaDB (Aktif jika DB_DRIVER=mysql)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=moduref
MYSQL_PASSWORD=moduref-local
MYSQL_DATABASE=moduref_demo

# Konfigurasi PostgreSQL (Aktif jika DB_DRIVER=postgres atau DB_DRIVER=pgsql)
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=moduref_demo

