PORT=8000
APP_URL=http://localhost:8000
SESSION_SECRET=local-php-demo-secret-key-change-in-production

# Driver Database: "sqlite", "mysql", atau "pgsql" ("postgres")
DB_DRIVER=sqlite

# Konfigurasi SQLite (Default: langsung jalan tanpa setup server database)
DB_SQLITE_PATH=database.sqlite

# Konfigurasi MySQL / MariaDB (Aktif jika DB_DRIVER=mysql)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=moduref_demo
MYSQL_USER=root
MYSQL_PASSWORD=

# Konfigurasi PostgreSQL (Aktif jika DB_DRIVER=pgsql atau DB_DRIVER=postgres)
PGSQL_HOST=127.0.0.1
PGSQL_PORT=5432
PGSQL_DATABASE=moduref_demo
PGSQL_USER=postgres
PGSQL_PASSWORD=

